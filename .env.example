PORT=3080
PANEL_PASSWORD=changeme
SESSION_SECRET=replace-with-long-random-string
# 32+ characters; used to encrypt provider credentials at rest
CREDENTIALS_KEY=replace-with-at-least-32-char-secret-key!!

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# VictoriaMetrics for ICMP down/up alerts + hourly fleet summary (empty = disabled).
# On VPS with monitoring compose: http://vm:8428 (shared Docker network monitoring_monitoring)
VICTORIAMETRICS_URL=http://vm:8428
MONITOR_POLL_MS=60000
MONITOR_DOWN_TICKS=2
MONITOR_SUMMARY_CRON=5 * * * *

TZ=Europe/Moscow
SYNC_CRON=0 */6 * * *
REMINDER_CRON=15 * * * *
REMINDER_DAYS=7,3,1,0
BALANCE_THRESHOLD=500

# Set to 0 to see browser UI while debugging scrapers
PLAYWRIGHT_HEADLESS=1

DATA_DIR=./data

# Optional: restrict /metrics to local/docker network (comma-separated IPs). Empty = allow all.
# METRICS_ALLOW_IPS=127.0.0.1,172.17.0.0/16
