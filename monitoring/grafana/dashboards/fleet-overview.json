{
  "uid": "fleet-overview",
  "title": "Fleet Overview",
  "tags": ["monitoring", "hosts"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Servers Up",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        { "expr": "count(up{job=~\"node.*\"} == 1)", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "palette-classic" } } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Servers Down",
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        { "expr": "count(up{job=~\"node.*\"} == 0) or vector(0)", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Availability %",
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        { "expr": "(count(up{job=~\"node.*\"} == 1) / count(up{job=~\"node.*\"})) * 100", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Due ≤ 7 Days",
      "gridPos": { "h": 4, "w": 4, "x": 15, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        { "expr": "billing_urgent_due_total or vector(0)", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total Servers",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        { "expr": "count(up{job=~\"node.*\"})", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "none" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Internet RX by Host (Mb/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "sum by(host) (rate(node_network_receive_bytes_total{job=~\"node.*\",device!~\"lo|docker.*|veth.*\"}[5m])) * 8 / 1000000",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Mbps", "min": 0 } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Internet TX by Host (Mb/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "sum by(host) (rate(node_network_transmit_bytes_total{job=~\"node.*\",device!~\"lo|docker.*|veth.*\"}[5m])) * 8 / 1000000",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Mbps", "min": 0 } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "CPU Usage % by Host",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "100 - (avg by(host) (rate(node_cpu_seconds_total{mode=\"idle\",job=~\"node.*\"}[5m])) * 100)",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "RAM Usage % by Host",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes{job=~\"node.*\"} / node_memory_MemTotal_bytes{job=~\"node.*\"})) * 100",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }
    }
  ]
}
