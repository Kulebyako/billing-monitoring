{
  "uid": "security-overview",
  "title": "Security Overview",
  "tags": ["monitoring", "security", "ufw", "fail2ban"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Banned IPs (fleet)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        { "expr": "sum(node_security_fail2ban_banned) or vector(0)", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "UFW Blocks / Hour",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        { "expr": "sum(node_security_ufw_blocks_1h) or vector(0)", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "UFW Active Hosts",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        { "expr": "sum(node_security_ufw_enabled) or vector(0)", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "fail2ban Jails",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        { "expr": "sum(node_security_fail2ban_jails) or vector(0)", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "UFW Blocks / Hour by Host",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "node_security_ufw_blocks_1h",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "min": 0 } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Banned IPs by Jail",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "node_security_fail2ban_banned",
          "legendFormat": "{{host}} / {{jail}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "min": 0 } }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Top Attacked Hosts (UFW blocks / hour)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "topk(12, node_security_ufw_blocks_1h)",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Security Status by Host",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "node_security_ufw_enabled",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "node_security_ufw_blocks_1h",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "sum by(host) (node_security_fail2ban_banned)",
          "format": "table",
          "instant": true,
          "refId": "C"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "job": true, "__name__": true, "instance": true, "env": true, "role": true },
            "renameByName": {
              "host": "Host",
              "provider": "Provider",
              "Value #A": "UFW Active",
              "Value #B": "UFW Blocks/h",
              "Value #C": "Banned IPs"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "UFW Active" },
            "properties": [
              { "id": "mappings", "value": [{ "type": "value", "options": { "0": { "text": "off", "color": "red" }, "1": { "text": "on", "color": "green" } } }] }
            ]
          }
        ]
      }
    }
  ]
}
